{
  "name": "@ux/shell",
  "version": "0.1.0",
  "description": "UxKit 工作台布局壳：AppShell / TitleBar / DockWorkbench / StatusBar",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./src/styles.css"
    }
  },
  "dependencies": {
    "@ux/components": "workspace:*",
    "@ux/composables": "workspace:*",
    "@ux/services": "workspace:*",
    "vue": "^3.5.13"
  }
}
