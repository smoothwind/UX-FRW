{
  "name": "ux-frw",
  "version": "0.1.0",
  "private": true,
  "description": "UxKit - 统一桌面交互框架（tokens / composables / services / components / shell / patterns）",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @ux/playground dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "size": "node scripts/size-report.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:shortcuts": "node scripts/check-shortcuts.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:commands": "node scripts/check-commands.mjs",
    "check": "node scripts/check-tokens.mjs && node scripts/check-icons.mjs && node scripts/check-shortcuts.mjs && node scripts/check-i18n.mjs && node scripts/check-commands.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
